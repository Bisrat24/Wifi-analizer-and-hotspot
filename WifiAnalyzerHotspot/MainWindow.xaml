<Window x:Class="WifiAnalyzerHotspot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WifiAnalyzerHotspot.ViewModels"
        xmlns:controls="clr-namespace:WifiAnalyzerHotspot.Controls"
        mc:Ignorable="d"
        Title="WiFi Analyzer &amp; Hotspot Pro"
        Icon="pack://application:,,,/WifiAnalyzerHotspot;component/app.ico"
        Height="780" Width="1220"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0C0E14"
        Foreground="#E2E8F0">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E2333"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2D354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A324A"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Cyan Button Style -->
        <Style x:Key="PrimaryCyanBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#00B0FF"/>
            <Setter Property="Foreground" Value="#0C0E14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#141724"/>
            <Setter Property="BorderBrush" Value="#23293D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#181C2B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="#10131E" BorderBrush="#1F2538" BorderThickness="0,0,1,0">
            <Grid Margin="12,18,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Row="0" Margin="4,0,4,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#1E2742" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/WifiAnalyzerHotspot;component/app.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WiFi Analyzer" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="&amp; HOTSPOT PRO" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                <Border Background="#1C2338" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                    <TextBlock Text="v1.0.7" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Separator Grid.Row="1" Background="#1D2336" Margin="0,0,0,14"/>

                <!-- Navigation Tabs List -->
                <StackPanel Grid.Row="2">
                    <!-- Tab 1: Spectrum & Channels -->
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Analyzer"
                            Background="{Binding CurrentTab, Converter={StaticResource TabBrushConv}, ConverterParameter=Analyzer}"
                            BorderBrush="{Binding CurrentTab, Converter={StaticResource TabBorderBrushConv}, ConverterParameter=Analyzer}"
                            BorderThickness="2" Margin="0,0,0,6" Height="44" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F4E1;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Spectrum &amp; Channels" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 2: Channel Ratings -->
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Ratings"
                            Background="{Binding CurrentTab, Converter={StaticResource TabBrushConv}, ConverterParameter=Ratings}"
                            BorderBrush="{Binding CurrentTab, Converter={StaticResource TabBorderBrushConv}, ConverterParameter=Ratings}"
                            BorderThickness="2" Margin="0,0,0,6" Height="44" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F4CA;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Channel Ratings" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 3: Speed Test -->
                    <Button Command="{Binding SetTabCommand}" CommandParameter="SpeedTest"
                            Background="{Binding CurrentTab, Converter={StaticResource TabBrushConv}, ConverterParameter=SpeedTest}"
                            BorderBrush="{Binding CurrentTab, Converter={StaticResource TabBorderBrushConv}, ConverterParameter=SpeedTest}"
                            BorderThickness="2" Margin="0,0,0,6" Height="44" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Speed Test &amp; Live" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 4: Mobile Hotspot -->
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Hotspot"
                            Background="{Binding CurrentTab, Converter={StaticResource TabBrushConv}, ConverterParameter=Hotspot}"
                            BorderBrush="{Binding CurrentTab, Converter={StaticResource TabBorderBrushConv}, ConverterParameter=Hotspot}"
                            BorderThickness="2" Margin="0,0,0,6" Height="44" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F525;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Mobile Hotspot" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 5: Network Info -->
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Info"
                            Background="{Binding CurrentTab, Converter={StaticResource TabBrushConv}, ConverterParameter=Info}"
                            BorderBrush="{Binding CurrentTab, Converter={StaticResource TabBorderBrushConv}, ConverterParameter=Info}"
                            BorderThickness="2" Margin="0,0,0,6" Height="44" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x2139;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Network Info" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 6: Connection Stabilizer -->
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Stabilizer"
                            Background="{Binding CurrentTab, Converter={StaticResource TabBrushConv}, ConverterParameter=Stabilizer}"
                            BorderBrush="{Binding CurrentTab, Converter={StaticResource TabBorderBrushConv}, ConverterParameter=Stabilizer}"
                            BorderThickness="2" Margin="0,0,0,6" Height="44" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F6E1;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Connection Stabilizer" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Bottom Sidebar Card: Connected Adapter Status -->
                <Border Grid.Row="3" Background="#161B29" BorderBrush="#252C42" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ACTIVE ADAPTER" FontSize="9" FontWeight="Bold" Foreground="#7C88A8" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ConnectedInterface.InterfaceName}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ConnectedInterface.Ssid, StringFormat='Connected: {0}'}" FontSize="11" Foreground="#00E5FF" Margin="0,2,0,4" TextTrimming="CharacterEllipsis"/>
                        
                        <ProgressBar Height="4" Maximum="100" Value="{Binding ConnectedInterface.Signal}"
                                     Foreground="{Binding ConnectedInterface.Signal, Converter={StaticResource SignalBrushConv}}"
                                     Background="#232B40" BorderThickness="0" Margin="0,2,0,4"/>
                        
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding ConnectedInterface.Signal, StringFormat='Signal: {0}%'}" FontSize="10" Foreground="#8FA0C2"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectedInterface.Channel, StringFormat='Ch {0}'}" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Margin="0,0,0,16">
                <DockPanel LastChildFill="False">
                    <!-- Title & Status -->
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Wi-Fi Spectrum &amp; Hotspot Manager" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding ScanStatus}" FontSize="12" Foreground="#8B96AF" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Top Action Controls -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Auto-Scan Toggle -->
                        <CheckBox IsChecked="{Binding AutoScanEnabled}" Content="Auto-Scan (4s)"
                                  Foreground="#A3B1CC" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"/>

                        <!-- Manual Scan Now Button -->
                        <Button Style="{StaticResource ModernBtn}" Command="{Binding ScanNowCommand}" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F504;" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/>
                                <TextBlock Text="Scan Now" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== TAB 1: SPECTRUM & CHANNELS ==================== -->
            <Grid Grid.Row="1" Visibility="{Binding CurrentTab, Converter={StaticResource TabVisConv}, ConverterParameter=Analyzer}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="290"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Controls: Band Switcher & Search Filter -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <!-- Band Buttons -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="Band:" FontSize="13" FontWeight="SemiBold" Foreground="#A2B1CD" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Button Command="{Binding SetBandCommand}" CommandParameter="2.4 GHz"
                                Background="{Binding SelectedBand, Converter={StaticResource BandBrushConv}, ConverterParameter=2.4 GHz}"
                                Foreground="{Binding SelectedBand, Converter={StaticResource BandFgConv}, ConverterParameter=2.4 GHz}"
                                Style="{StaticResource ModernBtn}" Height="30" Padding="12,4" Margin="0,0,6,0">
                            <TextBlock Text="2.4 GHz" FontWeight="Bold"/>
                        </Button>

                        <Button Command="{Binding SetBandCommand}" CommandParameter="5 GHz"
                                Background="{Binding SelectedBand, Converter={StaticResource BandBrushConv}, ConverterParameter=5 GHz}"
                                Foreground="{Binding SelectedBand, Converter={StaticResource BandFgConv}, ConverterParameter=5 GHz}"
                                Style="{StaticResource ModernBtn}" Height="30" Padding="12,4" Margin="0,0,6,0">
                            <TextBlock Text="5 GHz" FontWeight="Bold"/>
                        </Button>

                        <Button Command="{Binding SetBandCommand}" CommandParameter="All"
                                Background="{Binding SelectedBand, Converter={StaticResource BandBrushConv}, ConverterParameter=All}"
                                Foreground="{Binding SelectedBand, Converter={StaticResource BandFgConv}, ConverterParameter=All}"
                                Style="{StaticResource ModernBtn}" Height="30" Padding="12,4">
                            <TextBlock Text="All Networks" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>

                    <!-- Search Filter -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="220" Height="32"
                                 Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Filter SSID or MAC..." VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Vector Spectrum Canvas Graph -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,0,12">
                    <controls:SpectrumCanvas Networks="{Binding Networks}" SelectedBand="{Binding SelectedBand}"/>
                </Border>

                <!-- Networks DataGrid / ListView -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                    <DataGrid ItemsSource="{Binding FilteredNetworks}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2436"
                              RowBackground="#141724" AlternatingRowBackground="#111420"
                              RowHeight="36"
                              SelectionMode="Single" Foreground="#E2E8F0" FontSize="12">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#171C2B"/>
                                <Setter Property="Foreground" Value="#8F9EBC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#252D45"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Color Dot Indicator -->
                            <DataGridTemplateColumn Header="" Width="32">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SSID -->
                            <DataGridTemplateColumn Header="SSID (NETWORK)" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="&#x2605;" FontFamily="Segoe UI Emoji" Foreground="#FFEA00" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsConnected, Converter={StaticResource BoolVisConv}}"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Signal Strength -->
                            <DataGridTemplateColumn Header="SIGNAL" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SignalPercent, StringFormat='{}{0}%'}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                                       Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <ProgressBar Height="7" Maximum="100" Value="{Binding SignalPercent}"
                                                         Foreground="{Binding SignalPercent, Converter={StaticResource SignalBrushConv}}"
                                                         Background="#252C42" BorderThickness="0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- RSSI -->
                            <DataGridTextColumn Header="RSSI (dBm)" Binding="{Binding Rssi, StringFormat='{}{0} dBm'}" Width="85"/>

                            <!-- Channel & Width -->
                            <DataGridTemplateColumn Header="CHANNEL" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C2236" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock FontWeight="Bold" Foreground="#00E5FF">
                                                <Run Text="CH "/><Run Text="{Binding Channel}"/><Run Text=" ("/><Run Text="{Binding ChannelWidthMHz}"/><Run Text=" MHz)"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Band -->
                            <DataGridTextColumn Header="BAND" Binding="{Binding Band}" Width="75"/>

                            <!-- Radio Type / Protocol -->
                            <DataGridTextColumn Header="STANDARD" Binding="{Binding RadioType}" Width="130"/>

                            <!-- Security -->
                            <DataGridTextColumn Header="SECURITY" Binding="{Binding Authentication}" Width="120"/>

                            <!-- BSSID / MAC -->
                            <DataGridTextColumn Header="BSSID (MAC)" Binding="{Binding Bssid}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ==================== TAB 2: CHANNEL RATINGS & INTERFERENCE ==================== -->
            <Grid Grid.Row="1" Visibility="{Binding CurrentTab, Converter={StaticResource TabVisConv}, ConverterParameter=Ratings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Channel Recommendation Banner -->
                        <Border Style="{StaticResource CardBorder}" Background="#121F2D" BorderBrush="#00B0FF" Margin="0,0,0,16">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="8" Background="#1D334C" Margin="0,0,14,0">
                                    <TextBlock Text="&#x1F4A1;" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Channel Congestion &amp; Interference Analysis" FontSize="16" FontWeight="Bold" Foreground="#00E5FF"/>
                                    <TextBlock Text="{Binding BestChannelAdvice}" FontSize="13" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 2.4 GHz Channels Grid -->
                        <TextBlock Text="2.4 GHz Channels (Rating &amp; Overlap)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="0">
                            <DataGrid ItemsSource="{Binding Ratings24G}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2436"
                                      RowBackground="#141724" AlternatingRowBackground="#111420"
                                      Foreground="#E2E8F0" FontSize="12">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#171C2B"/>
                                        <Setter Property="Foreground" Value="#8F9EBC"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderBrush" Value="#252D45"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CHANNEL" Binding="{Binding Channel, StringFormat='Channel {0}'}" FontWeight="Bold" Width="95"/>
                                    <DataGridTextColumn Header="STARS" Binding="{Binding Stars}" Foreground="#FFEA00" Width="95"/>
                                    
                                    <DataGridTemplateColumn Header="SCORE" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center" Margin="4,0">
                                                    <ProgressBar Height="8" Maximum="100" Value="{Binding Score}"
                                                                 Foreground="{Binding BadgeBrush}" Background="#252C42" BorderThickness="0"/>
                                                    <TextBlock Text="{Binding Score, StringFormat='{}{0}/100'}"
                                                               FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"
                                                               HorizontalAlignment="Right" Margin="0,-18,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="SAME CHANNEL APs" Binding="{Binding CoChannelCount}" Width="135"/>
                                    <DataGridTextColumn Header="OVERLAPPING APs" Binding="{Binding OverlapCount}" Width="135"/>
                                    
                                    <DataGridTemplateColumn Header="STATUS / RECOMMENDATION" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A2133" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding BadgeBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 5 GHz Channels Grid -->
                        <TextBlock Text="5 GHz Channels (High-Speed Bands)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="0">
                            <DataGrid ItemsSource="{Binding Ratings5G}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2436"
                                      RowBackground="#141724" AlternatingRowBackground="#111420"
                                      Foreground="#E2E8F0" FontSize="12">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#171C2B"/>
                                        <Setter Property="Foreground" Value="#8F9EBC"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderBrush" Value="#252D45"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CHANNEL" Binding="{Binding Channel, StringFormat='Channel {0}'}" FontWeight="Bold" Width="95"/>
                                    <DataGridTextColumn Header="STARS" Binding="{Binding Stars}" Foreground="#FFEA00" Width="95"/>
                                    
                                    <DataGridTemplateColumn Header="SCORE" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center" Margin="4,0">
                                                    <ProgressBar Height="8" Maximum="100" Value="{Binding Score}"
                                                                 Foreground="{Binding BadgeBrush}" Background="#252C42" BorderThickness="0"/>
                                                    <TextBlock Text="{Binding Score, StringFormat='{}{0}/100'}"
                                                               FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"
                                                               HorizontalAlignment="Right" Margin="0,-18,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="SAME CHANNEL APs" Binding="{Binding CoChannelCount}" Width="135"/>
                                    <DataGridTextColumn Header="OVERLAPPING APs" Binding="{Binding OverlapCount}" Width="135"/>
                                    
                                    <DataGridTemplateColumn Header="STATUS / RECOMMENDATION" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A2133" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding BadgeBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== TAB 3: SPEED TEST & LIVE TRAFFIC ==================== -->
            <Grid Grid.Row="1" Visibility="{Binding CurrentTab, Converter={StaticResource TabVisConv}, ConverterParameter=SpeedTest}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Speedometer Dial & Test Controls -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="INTERNET SPEED TEST" FontSize="13" FontWeight="Bold" Foreground="#7C88A8" HorizontalAlignment="Center"/>

                        <!-- Gauge Dial -->
                        <controls:SpeedGauge Grid.Row="1" Value="{Binding SpeedMetrics.GaugeValue}"
                                             StageText="{Binding SpeedMetrics.Stage}"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <!-- Progress Bar & Stage Status -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,16">
                            <TextBlock Text="{Binding SpeedMetrics.StatusMessage}" FontSize="12" Foreground="#00E5FF"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <ProgressBar Height="6" Maximum="100" Value="{Binding SpeedMetrics.Progress}"
                                         Foreground="#00E5FF" Background="#21283B" BorderThickness="0"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryCyanBtn}" Command="{Binding StartSpeedTestCommand}"
                                    IsEnabled="{Binding CanStartSpeedTest}"
                                    Width="160" Height="42" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F680;" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/>
                                    <TextBlock Text="START TEST"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ModernBtn}" Command="{Binding CancelSpeedTestCommand}"
                                    IsEnabled="{Binding SpeedMetrics.IsTesting}"
                                    Width="90" Height="42" Content="Cancel"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Column: Metrics Cards & Real-time Live Network Monitor -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 4 Metric Cards (Ping, Jitter, Download, Upload) -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Download Card -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="DOWNLOAD" FontSize="11" FontWeight="Bold" Foreground="#7C88A8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SpeedMetrics.DownloadMbps, StringFormat='{}{0:F1}'}" FontSize="24" FontWeight="Bold" Foreground="#00E5FF"/>
                                    <TextBlock Text=" Mbps" FontSize="12" FontWeight="SemiBold" Foreground="#7C88A8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Upload Card -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="UPLOAD" FontSize="11" FontWeight="Bold" Foreground="#7C88A8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SpeedMetrics.UploadMbps, StringFormat='{}{0:F1}'}" FontSize="24" FontWeight="Bold" Foreground="#D500F9"/>
                                    <TextBlock Text=" Mbps" FontSize="12" FontWeight="SemiBold" Foreground="#7C88A8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ping Card -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="LATENCY" FontSize="11" FontWeight="Bold" Foreground="#7C88A8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SpeedMetrics.PingMs, StringFormat='{}{0:F0}'}" FontSize="24" FontWeight="Bold" Foreground="#00E676"/>
                                    <TextBlock Text=" ms" FontSize="12" FontWeight="SemiBold" Foreground="#7C88A8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Jitter Card -->
                        <Border Grid.Column="3" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="JITTER" FontSize="11" FontWeight="Bold" Foreground="#7C88A8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SpeedMetrics.JitterMs, StringFormat='{}{0:F1}'}" FontSize="24" FontWeight="Bold" Foreground="#FFEA00"/>
                                    <TextBlock Text=" ms" FontSize="12" FontWeight="SemiBold" Foreground="#7C88A8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Wi-Fi Link Speed vs ISP Internet Speed Clarification -->
                    <Border Grid.Row="1" Background="#161C2C" BorderBrush="#25324D" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#x1F4F6; WI-FI HARDWARE LINK SPEED: " FontFamily="Segoe UI Emoji" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                <TextBlock Text="{Binding ConnectedInterface.RxRateMbps, StringFormat='{}{0} Mbps'}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="  &#x2022;  SSID: " FontSize="11" Foreground="#7C88A8"/>
                                <TextBlock Text="{Binding ConnectedInterface.Ssid}" FontSize="11" FontWeight="SemiBold" Foreground="#00E676"/>
                            </StackPanel>
                            <TextBlock Text="&#x1F4A1; Note on Internet Speed: The test above measures your real-time external download &amp; upload throughput across global CDN test nodes. Wi-Fi Link Speed (above) is the internal radio limit between your PC and router."
                                       FontSize="10" Foreground="#8F9EBC" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Live Adapter Throughput Monitor -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="REAL-TIME NETWORK TRAFFIC" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Live throughput of active wireless network adapter" FontSize="11" Foreground="#7C88A8"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#1D273B" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="LIVE MONITOR" FontSize="10" FontWeight="Bold" Foreground="#00E676"/>
                                </Border>
                            </DockPanel>

                            <!-- Live Gauges / Readout Display -->
                            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <!-- Live Download Speed -->
                                <Border Grid.Column="0" Background="#182033" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#x2B07; CURRENT DOWNLOAD" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentTraffic.DownloadFormatted}" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Live Upload Speed -->
                                <Border Grid.Column="1" Background="#182033" CornerRadius="8" Padding="18" Margin="12,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#x2B06; CURRENT UPLOAD" FontSize="11" FontWeight="Bold" Foreground="#D500F9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentTraffic.UploadFormatted}" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Footer note -->
                            <TextBlock Grid.Row="2" Text="Updated continuously every second directly from Windows network interface statistics."
                                       FontSize="11" Foreground="#5E6B87" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== TAB 4: MOBILE HOTSPOT CREATOR ==================== -->
            <Grid Grid.Row="1" Visibility="{Binding CurrentTab, Converter={StaticResource TabVisConv}, ConverterParameter=Hotspot}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Hotspot Control & Settings Card -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Hotspot Stuck Auto-Reset 30s Countdown Alert Banner -->
                            <Border Background="#2A1B0E" BorderBrush="#FF9100" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                    Visibility="{Binding Hotspot.IsResetCountdownActive, Converter={StaticResource BoolVisConv}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x26A0;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="HOTSPOT UNRESPONSIVE - RESET IMMINENT" FontSize="11" FontWeight="Bold" Foreground="#FFB300"/>
                                            <TextBlock Text="{Binding Hotspot.ResetCountdownMessage}" FontSize="12" Foreground="#FFE082" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#3E2723" BorderBrush="#FF9100" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Hotspot.ResetCountdownSeconds, StringFormat='{}{0}s'}" FontSize="18" FontWeight="Bold" Foreground="#FFD54F" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding CancelHotspotResetCommand}" Style="{StaticResource ModernBtn}"
                                                Background="#37474F" BorderBrush="#78909C" Foreground="#ECEFF1" Height="34" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x2716;" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/>
                                                <TextBlock Text="Cancel Auto-Reset"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetHotspotNowCommand}" Style="{StaticResource ModernBtn}"
                                                Background="#D84315" BorderBrush="#FF7043" Foreground="#FFFFFF" Height="34" Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/>
                                                <TextBlock Text="Reset Now"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Hotspot Status Banner -->
                            <Border Background="#161B29" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="HOTSPOT STATUS" FontSize="10" FontWeight="Bold" Foreground="#7C88A8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="10" Height="10" Fill="{Binding Hotspot.State, Converter={StaticResource HotspotBrushConv}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Hotspot.StateText}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Hotspot.UptimeText, StringFormat='&#x23F1; Uptime: {0}'}" FontFamily="Segoe UI Emoji" FontSize="11" Foreground="#00E5FF" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Hotspot.StatusMessage}" FontSize="11" Foreground="#8F9EBC" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Main Power Toggle Button -->
                                    <Button Grid.Column="1" Command="{Binding ToggleHotspotCommand}"
                                            IsEnabled="{Binding Hotspot.IsBusy, Converter={StaticResource InverseBoolConv}}"
                                            Background="{Binding Hotspot.State, Converter={StaticResource HotspotBrushConv}}"
                                            Foreground="#0C0E14" FontWeight="Bold" FontSize="12"
                                            Padding="16,10" Height="42" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Emoji" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Hotspot.PowerButtonText}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Live Active Broadcast Channel Card -->
                            <Border Background="#101D2D" BorderBrush="#00B0FF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="BROADCAST CHANNEL &amp; FREQUENCY" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="Active Channel: " FontSize="13" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding Hotspot.ActiveChannel}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text=" (" FontSize="13" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding Hotspot.ActiveBand}" FontSize="13" FontWeight="Bold" Foreground="#00E5FF"/>
                                            <TextBlock Text=")" FontSize="13" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Hotspot.ChannelDescription}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#162D42" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Hotspot.ActiveChannel}" FontWeight="Bold" Foreground="#00E5FF" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel Advice Callout -->
                            <Border Background="#131F33" BorderBrush="#2A3D66" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="&#x1F3AF; SPECTRUM RECOMMENDATION" FontFamily="Segoe UI Emoji" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                    <TextBlock Text="{Binding BestChannelAdvice}" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Settings: SSID, Password, Channel & Band -->
                            <TextBlock Text="HOTSPOT CONFIGURATION" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                            <!-- Network Name (SSID) -->
                            <TextBlock Text="Network Name (SSID)" FontSize="12" Foreground="#8FA0C2" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding HotspotSsidInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <!-- Password -->
                            <TextBlock Text="Password / Security Key (Min 8 chars)" FontSize="12" Foreground="#8FA0C2" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding HotspotPasswordInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <!-- Hardware Radio Architecture Explanation -->
                            <Border Background="#131B2A" BorderBrush="#25354F" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2139;&#xFE0F;" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/>
                                        <TextBlock Text="Hardware Radio Concurrency" FontWeight="Bold" FontSize="11" Foreground="#00E5FF"/>
                                    </StackPanel>
                                    <TextBlock Text="Your Wi-Fi card is connected to 'Africa' on Channel 11. Under Windows Single-Channel Concurrency (SCC), the 2.4 GHz hotspot synchronizes to Channel 11 so you can share your internet without disconnecting from Wi-Fi."
                                               FontSize="10" Foreground="#8FA0C2" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Channel & Band Selection -->
                            <TextBlock Text="Hotspot Band / Channel Selection" FontSize="12" Foreground="#8FA0C2" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableHotspotChannels}"
                                      SelectedItem="{Binding HotspotChannelChoice}"
                                      Background="#181C2B" Foreground="#000000" FontSize="12" Padding="8,6" Margin="0,0,0,10"/>

                            <!-- Channel Availability Notice -->
                            <Border Background="#151C2C" BorderBrush="#25354F" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="&#x1F4A1; Channel Availability &amp; Cable Network Mode:" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" Margin="0,0,0,3"/>
                                    <TextBlock Text="&#x2022; On Wi-Fi: Hardware Single-Channel Concurrency locks the SoftAP to your active Wi-Fi channel (Channel 11) so internet sharing stays active."
                                               FontSize="10" Foreground="#8FA0C2" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    <TextBlock Text="&#x2022; On Ethernet / Cable: The Wi-Fi adapter is not sharing an incoming Wi-Fi connection, allowing full custom channel selection across all 2.4 GHz and 5 GHz bands."
                                               FontSize="10" Foreground="#00E676" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Health Watchdog Checkbox -->
                            <Border Background="#131B2A" BorderBrush="#1F2A3F" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding Hotspot.IsHealthCheckEnabled}" Foreground="#E2E8F0" VerticalContentAlignment="Center" Cursor="Hand">
                                    <StackPanel Orientation="Vertical" Margin="4,0,0,0">
                                        <TextBlock Text="Hotspot Health Watchdog (5s Stuck Detection)" FontWeight="SemiBold" FontSize="12" Foreground="#00E5FF"/>
                                        <TextBlock Text="Monitors tethering state with 5s threshold. If Windows hangs in transition, provides a 30s cancellation countdown before auto-recovering." FontSize="10" Foreground="#8FA0C2" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- DHCP Scope Optimization & Subnet Repair Card -->
                            <Border Background="#0F1B2B" BorderBrush="#1E385B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F6E1;&#xFE0F; DHCP &amp; ICS IP SCOPE" FontFamily="Segoe UI Emoji" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                        <TextBlock Text="{Binding Hotspot.DhcpPoolInfo}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        <TextBlock Text="Prevents 'Obtaining IP address...' errors on connecting devices." FontSize="9" Foreground="#64748B" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding TestWatchdogCommand}" Style="{StaticResource ModernBtn}"
                                                Height="30" Padding="8,4" FontSize="11" Margin="0,0,6,0" Background="#261C14" BorderBrush="#FF9100" Foreground="#FFB74D"
                                                ToolTip="Test the 30-second Stuck Watchdog countdown alert">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x23F1;" FontFamily="Segoe UI Emoji" Margin="0,0,4,0"/>
                                                <TextBlock Text="Test Watchdog"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RepairDhcpCommand}" Style="{StaticResource ModernBtn}"
                                                Height="30" Padding="8,4" FontSize="11" Background="#162D42" BorderBrush="#00B0FF" Foreground="#00E5FF">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Emoji" Margin="0,0,4,0"/>
                                                <TextBlock Text="Repair DHCP"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Keep-Alive Anti-Idle Checkbox -->
                            <Border Background="#131B2A" BorderBrush="#1F2A3F" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding Hotspot.KeepHotspotAlive}" Foreground="#E2E8F0" VerticalContentAlignment="Center" Cursor="Hand">
                                    <StackPanel Orientation="Vertical" Margin="4,0,0,0">
                                        <TextBlock Text="Keep Hotspot Alive (Anti-Idle Auto-Restart)" FontWeight="SemiBold" FontSize="12" Foreground="#00E5FF"/>
                                        <TextBlock Text="Automatically reactivates Hotspot if Windows turns it off due to 0 clients or idle sleep timeout." FontSize="10" Foreground="#8FA0C2" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Save & Copy Details Buttons -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PrimaryCyanBtn}" Command="{Binding SaveHotspotConfigCommand}"
                                        IsEnabled="{Binding Hotspot.IsBusy, Converter={StaticResource InverseBoolConv}}"
                                        Height="38" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4BE;" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/>
                                        <TextBlock Text="Save Settings"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource ModernBtn}" Command="{Binding CopyHotspotDetailsCommand}"
                                        Height="38" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4CB;" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/>
                                        <TextBlock Text="Copy Details"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button Style="{StaticResource ModernBtn}" Command="{Binding RefreshHotspotCommand}"
                                    Height="34" Content="Refresh Hotspot Status"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                                <!-- Right Column: Connected Clients & Blocked Devices -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Card: Connected Clients -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header with Refresh Button & Badge -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="CONNECTED CLIENT DEVICES" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Live devices currently using this mobile hotspot" FontSize="11" Foreground="#7C88A8"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ModernBtn}" Command="{Binding RefreshHotspotCommand}"
                                            Height="30" Padding="10,3" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F504;" FontFamily="Segoe UI Emoji" Margin="0,0,5,0"/>
                                            <TextBlock Text="Refresh Clients" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Background="#1D253B" CornerRadius="12" Padding="12,5">
                                        <TextBlock Text="{Binding Hotspot.ClientCount, StringFormat='{}{0} Connected'}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- Client Devices List -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Hotspot.Clients}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2436"
                                      RowBackground="#141724" AlternatingRowBackground="#111420"
                                      Foreground="#E2E8F0" FontSize="12">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#171C2B"/>
                                        <Setter Property="Foreground" Value="#8F9EBC"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderBrush" Value="#252D45"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DEVICE / HOST NAME" Binding="{Binding HostName}" FontWeight="SemiBold" Width="140"/>
                                    <DataGridTemplateColumn Header="CONNECTION SPEED" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#10253B" BorderBrush="#1C4066" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Emoji" FontSize="11" Margin="0,0,4,0" Foreground="#00E5FF"/>
                                                        <TextBlock Text="{Binding ConnectionSpeed}" FontWeight="SemiBold" FontSize="11" Foreground="#00E5FF"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="IP ADDRESS" Binding="{Binding IpAddress}" FontWeight="SemiBold" Foreground="#00E5FF" Width="110"/>
                                    <DataGridTextColumn Header="MAC ADDRESS" Binding="{Binding MacAddress}" Width="130"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Foreground="#00E676" Width="80"/>
                                    <DataGridTemplateColumn Header="ACTIONS" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ModernBtn}" Height="24" Padding="8,2" Margin="0,0,6,0"
                                                            Background="#2A2118" BorderBrush="#FF9100" BorderThickness="1"
                                                            Command="{Binding DataContext.DisconnectClientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" ToolTip="Disconnect this device from hotspot">
                                                        <TextBlock Text="Disconnect" FontSize="10" FontWeight="SemiBold" Foreground="#FFB74D"/>
                                                    </Button>
                                                    <Button Style="{StaticResource ModernBtn}" Height="24" Padding="8,2"
                                                            Background="#2B141B" BorderBrush="#FF1744" BorderThickness="1"
                                                            Command="{Binding DataContext.BlockClientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" ToolTip="Block this device from hotspot">
                                                        <TextBlock Text="Block" FontSize="10" FontWeight="SemiBold" Foreground="#FF5252"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Bottom Card: Blocked Devices (Blacklist) -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#FF1744" Margin="0,0,8,0"/>
                                    <TextBlock Text="BLOCKED DEVICES (BLACKLIST)" FontSize="13" FontWeight="Bold" Foreground="#FF5252"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#2B141B" CornerRadius="12" Padding="12,4">
                                    <TextBlock Text="{Binding Hotspot.BlockedClients.Count, StringFormat='{}{0} Blocked'}"
                                               FontSize="11" FontWeight="Bold" Foreground="#FF5252"/>
                                </Border>
                            </DockPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Hotspot.BlockedClients}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2436"
                                      RowBackground="#141724" AlternatingRowBackground="#111420"
                                      Foreground="#E2E8F0" FontSize="12">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#171C2B"/>
                                        <Setter Property="Foreground" Value="#8F9EBC"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderBrush" Value="#252D45"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DEVICE / HOST NAME" Binding="{Binding HostName}" FontWeight="SemiBold" Width="170"/>
                                    <DataGridTextColumn Header="MAC ADDRESS" Binding="{Binding MacAddress}" Width="160"/>
                                    <DataGridTextColumn Header="BLOCKED TIME" Binding="{Binding BlockedTime}" Foreground="#94A3B8" Width="110"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Reason}" Foreground="#FF5252" Width="*"/>
                                    <DataGridTemplateColumn Header="ACTION" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ModernBtn}" Height="24" Padding="8,2"
                                                        Background="#142B20" BorderBrush="#00E676" BorderThickness="1"
                                                        Command="{Binding DataContext.UnblockClientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" ToolTip="Unblock and restore hotspot access">
                                                    <TextBlock Text="Unblock" FontSize="10" FontWeight="SemiBold" Foreground="#69F0AE"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== TAB 5: NETWORK DETAILS ==================== -->
            <Grid Grid.Row="1" Visibility="{Binding CurrentTab, Converter={StaticResource TabVisConv}, ConverterParameter=Info}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Adapter Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="WIRELESS ADAPTER SPECIFICATIONS" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Interface Name:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectedInterface.InterfaceName}" FontWeight="SemiBold" Foreground="#FFFFFF"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Adapter Description:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectedInterface.Description}" FontWeight="SemiBold" Foreground="#FFFFFF"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="MAC Address:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectedInterface.Mac}" FontWeight="SemiBold" Foreground="#FFFFFF"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Local IPv4 Address:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConnectedInterface.Ipv4}" FontWeight="SemiBold" Foreground="#FFFFFF"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Default Gateway:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConnectedInterface.Gateway}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Link & Signal Quality Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="ACTIVE WI-FI LINK QUALITY" FontSize="14" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected SSID:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectedInterface.Ssid}" FontWeight="Bold" Foreground="#FFFFFF"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Connected BSSID:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectedInterface.Bssid}" FontWeight="SemiBold" Foreground="#FFFFFF"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Channel &amp; Band:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Foreground="#00E5FF">
                                        <Run Text="Channel "/><Run Text="{Binding ConnectedInterface.Channel}"/><Run Text=" ("/><Run Text="{Binding ConnectedInterface.Band}"/><Run Text=")"/>
                                    </TextBlock>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Radio Standard:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConnectedInterface.RadioType}" FontWeight="SemiBold" Foreground="#FFFFFF"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Receive Link Rate:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConnectedInterface.RxRateMbps, StringFormat='{}{0} Mbps'}" FontWeight="SemiBold" Foreground="#FFFFFF"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Transmit Link Rate:" Foreground="#8F9EBC"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ConnectedInterface.TxRateMbps, StringFormat='{}{0} Mbps'}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== TAB 6: CONNECTION STABILIZER ==================== -->
            <Grid Grid.Row="1" Visibility="{Binding CurrentTab, Converter={StaticResource TabVisConv}, ConverterParameter=Stabilizer}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ==================== LEFT: ACTIVE KEEP-ALIVE CARD ==================== -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header with Pulse Indicator -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#00E676" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0.3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stabilizer.IsPulseGlowing}" Value="True">
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#00E676" BlurRadius="14" ShadowDepth="0"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="ACTIVE KEEP-ALIVE" FontSize="15" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </StackPanel>
                                    
                                    <Border DockPanel.Dock="Right" Background="#1B2236" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding Stabilizer.KeepAliveStatusText}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                    </Border>
                                </DockPanel>

                                <!-- Subtitle Explanation -->
                                <TextBlock Grid.Row="1" Text="Sends ultra-lightweight periodic traffic bursts to keep Wi-Fi power-save sleep awake, maintain router NAT routing state, and prevent ISP/router idle disconnects."
                                           FontSize="12" Foreground="#8FA0C2" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"/>

                                <!-- Start / Stop Button -->
                                <Button Grid.Row="2" Command="{Binding ToggleKeepAliveCommand}" Height="40" Margin="0,0,0,14">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernBtn}">
                                            <Setter Property="Background" Value="#00C853"/>
                                            <Setter Property="Foreground" Value="#000000"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Content" Value="&#x25B6;  START ACTIVE KEEP-ALIVE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Stabilizer.IsKeepAliveActive}" Value="True">
                                                    <Setter Property="Background" Value="#D50000"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="Content" Value="&#x25A0;  STOP KEEP-ALIVE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Configuration Settings -->
                                <Border Grid.Row="3" Background="#161A28" BorderBrush="#252D42" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Heartbeat Interval -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pulse Interval:" Foreground="#8F9EBC" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding Stabilizer.KeepAliveIntervalChoice}" SelectedValuePath="Content"
                                                  Background="#1E2333" Foreground="#000000" FontSize="12" Padding="8,5" Margin="0,0,0,10">
                                            <ComboBoxItem Content="1 second (High Intensity - Gaming/Streaming)"/>
                                            <ComboBoxItem Content="3 seconds (Recommended for Unstable Wi-Fi)"/>
                                            <ComboBoxItem Content="5 seconds (Balanced - Standard Keep-Alive)" IsSelected="True"/>
                                            <ComboBoxItem Content="10 seconds (Lightweight / Low Battery)"/>
                                            <ComboBoxItem Content="15 seconds (Minimal Heartbeat)"/>
                                        </ComboBox>

                                        <!-- Target Host -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Server:" Foreground="#8F9EBC" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Text="{Binding Stabilizer.KeepAliveTarget}" IsEditable="True"
                                                  Background="#1E2333" Foreground="#000000" FontSize="12" Padding="8,5" Margin="0,0,0,10">
                                            <ComboBoxItem Content="1.1.1.1" IsSelected="True"/>
                                            <ComboBoxItem Content="8.8.8.8"/>
                                            <ComboBoxItem Content="9.9.9.9"/>
                                            <ComboBoxItem Content="192.168.1.1"/>
                                        </ComboBox>

                                        <!-- Probe Method -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Probe Protocol:" Foreground="#8F9EBC" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding Stabilizer.KeepAliveMethod}" SelectedValuePath="Content"
                                                  Background="#1E2333" Foreground="#000000" FontSize="12" Padding="8,5">
                                            <ComboBoxItem Content="ICMP Ping (Ultra-Lightweight / Fast)" IsSelected="True"/>
                                            <ComboBoxItem Content="TCP Port 53 (Bypasses Ping Firewalls)"/>
                                            <ComboBoxItem Content="HTTP HEAD (Web Proxy / Captive Portal Bypass)"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Telemetry Stats Cards -->
                                <Grid Grid.Row="4" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Sent -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#161B29" CornerRadius="6" Padding="10" Margin="0,0,6,6">
                                        <StackPanel>
                                            <TextBlock Text="PACKETS SENT" FontSize="9" FontWeight="Bold" Foreground="#7C88A8"/>
                                            <TextBlock Text="{Binding Stabilizer.PacketsSent}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Success -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="#161B29" CornerRadius="6" Padding="10" Margin="0,0,6,6">
                                        <StackPanel>
                                            <TextBlock Text="SUCCESSFUL" FontSize="9" FontWeight="Bold" Foreground="#7C88A8"/>
                                            <TextBlock Text="{Binding Stabilizer.PacketsSuccess}" FontSize="18" FontWeight="Bold" Foreground="#00E676" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lost -->
                                    <Border Grid.Row="0" Grid.Column="2" Background="#161B29" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="LOST" FontSize="9" FontWeight="Bold" Foreground="#7C88A8"/>
                                            <TextBlock Text="{Binding Stabilizer.PacketsLost}" FontSize="18" FontWeight="Bold" Foreground="#FF5252" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Loss Rate -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#161B29" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="PACKET LOSS" FontSize="9" FontWeight="Bold" Foreground="#7C88A8"/>
                                            <TextBlock Text="{Binding Stabilizer.PacketLossPercent, StringFormat='{}{0:F1}%'}" FontSize="18" FontWeight="Bold" Foreground="#FFD740" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Current Latency -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="#161B29" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="LIVE PING" FontSize="9" FontWeight="Bold" Foreground="#7C88A8"/>
                                            <TextBlock Text="{Binding Stabilizer.CurrentLatencyMs, StringFormat='{}{0:F0} ms'}" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Avg Latency -->
                                    <Border Grid.Row="1" Grid.Column="2" Background="#161B29" CornerRadius="6" Padding="10" Margin="0,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="AVG LATENCY" FontSize="9" FontWeight="Bold" Foreground="#7C88A8"/>
                                            <TextBlock Text="{Binding Stabilizer.AvgLatencyMs, StringFormat='{}{0:F0} ms'}" FontSize="18" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Live Heartbeat Stream Table -->
                                <Border Grid.Row="5" Background="#121522" BorderBrush="#22283C" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="180">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                            <TextBlock Text="LIVE HEARTBEAT LOG (LAST 300 MAX)" FontSize="10" FontWeight="Bold" Foreground="#7888A8"/>
                                            <TextBlock DockPanel.Dock="Right" Text="LATENCY" FontSize="10" FontWeight="Bold" Foreground="#7888A8" Margin="0,0,60,0"/>
                                        </DockPanel>

                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Stabilizer.HeartbeatHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#1C2133" BorderThickness="0,0,0,1" Padding="4,4">
                                                        <DockPanel LastChildFill="False">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="7" Height="7" CornerRadius="3.5" Background="{Binding StatusBrush}" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#8F9EBC" FontFamily="Consolas"/>
                                                            </StackPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyMs, StringFormat='{}{0:F0} ms'}" FontSize="11" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,24,0"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ==================== RIGHT: ACTIVE RECONNECT CARD ==================== -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F504;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="ACTIVE RECONNECT" FontSize="15" FontWeight="Bold" Foreground="#00E676"/>
                                    </StackPanel>
                                    
                                    <Border DockPanel.Dock="Right" Background="#1B2236" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding Stabilizer.ReconnectStatusText}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                    </Border>
                                </DockPanel>

                                <!-- Subtitle Explanation -->
                                <TextBlock Grid.Row="1" Text="Monitors real-time internet route integrity. If packet delivery stalls, instantly triggers low-level Wi-Fi re-association, DHCP lease renewal, or radio cycling to restore traffic."
                                           FontSize="12" Foreground="#8FA0C2" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"/>

                                <!-- Start / Stop Button -->
                                <Button Grid.Row="2" Command="{Binding ToggleReconnectCommand}" Height="40" Margin="0,0,0,14">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernBtn}">
                                            <Setter Property="Background" Value="#00B0FF"/>
                                            <Setter Property="Foreground" Value="#000000"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Content" Value="&#x25B6;  START ACTIVE RECONNECT"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Stabilizer.IsReconnectActive}" Value="True">
                                                    <Setter Property="Background" Value="#D50000"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="Content" Value="&#x25A0;  STOP ACTIVE RECONNECT"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Configuration Settings -->
                                <Border Grid.Row="3" Background="#161A28" BorderBrush="#252D42" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Target SSID -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Target SSID:" Foreground="#8F9EBC" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding Stabilizer.TargetSsid, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,5" Margin="0,0,0,10"/>

                                        <!-- Failure Threshold -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Drop Threshold:" Foreground="#8F9EBC" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding Stabilizer.FailureThresholdChoice}" SelectedValuePath="Content"
                                                  Background="#1E2333" Foreground="#000000" FontSize="12" Padding="8,5" Margin="0,0,0,10">
                                            <ComboBoxItem Content="2 consecutive drops (Aggressive Reconnect)"/>
                                            <ComboBoxItem Content="3 consecutive drops (Recommended Standard)" IsSelected="True"/>
                                            <ComboBoxItem Content="5 consecutive drops (High Tolerance)"/>
                                        </ComboBox>

                                        <!-- Recovery Strategy -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Recovery Mode:" Foreground="#8F9EBC" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding Stabilizer.ReconnectStrategy}" SelectedValuePath="Content"
                                                  Background="#1E2333" Foreground="#000000" FontSize="12" Padding="8,5" Margin="0,0,0,10">
                                            <ComboBoxItem Content="Fast Wi-Fi Re-auth (Instant 802.11 Reconnect)" IsSelected="True"/>
                                            <ComboBoxItem Content="DHCP IP Renew &amp; Reconnect (Fixes IP conflict)"/>
                                            <ComboBoxItem Content="Radio Cycle &amp; Reconnect (Full Wi-Fi Reset)"/>
                                            <ComboBoxItem Content="Adapter Reset (Disable/Enable NIC &#x2014; Most Aggressive)"/>
                                        </ComboBox>

                                        <!-- VPN & DHCP Buffer (Grace Period) -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="VPN / Link Buffer:" Foreground="#8F9EBC" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1" SelectedValue="{Binding Stabilizer.ReconnectBufferChoice}" SelectedValuePath="Content"
                                                  Background="#1E2333" Foreground="#000000" FontSize="12" Padding="8,5">
                                            <ComboBoxItem Content="10 seconds (Recommended â€¢ Cisco AnyConnect &amp; VPN)" IsSelected="True"/>
                                            <ComboBoxItem Content="5 seconds (Fast â€¢ Standard Home Wi-Fi)"/>
                                            <ComboBoxItem Content="15 seconds (Enterprise VPN &amp; MFA Token)"/>
                                            <ComboBoxItem Content="25 seconds (Slow Satellite / Corporate DHCP)"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Watchdog Counters -->
                                <Grid Grid.Row="4" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Total Drops -->
                                    <Border Grid.Column="0" Background="#161B29" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="DROPS DETECTED" FontSize="9" FontWeight="Bold" Foreground="#7C88A8"/>
                                            <TextBlock Text="{Binding Stabilizer.TotalDropsDetected}" FontSize="18" FontWeight="Bold" Foreground="#FF9100" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Reconnections -->
                                    <Border Grid.Column="1" Background="#161B29" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="RESTORED" FontSize="9" FontWeight="Bold" Foreground="#7C88A8"/>
                                            <TextBlock Text="{Binding Stabilizer.TotalReconnected}" FontSize="18" FontWeight="Bold" Foreground="#00E676" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Last Reconnect -->
                                    <Border Grid.Column="2" Background="#161B29" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="LAST RECONNECT" FontSize="9" FontWeight="Bold" Foreground="#7C88A8"/>
                                            <TextBlock Text="{Binding Stabilizer.LastReconnectTime}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Watchdog Event Log -->
                                <Border Grid.Row="5" Background="#121522" BorderBrush="#22283C" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="180">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="WATCHDOG EVENT LOG (LAST 300 MAX)" FontSize="10" FontWeight="Bold" Foreground="#7888A8" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Command="{Binding ClearStabilizerLogsCommand}" Content="Clear Log"
                                                    Style="{StaticResource ModernBtn}" Padding="8,2" FontSize="11" Height="24"/>
                                        </DockPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Stabilizer.ReconnectLogs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#A0AEC0" FontFamily="Consolas" Margin="0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Window>
