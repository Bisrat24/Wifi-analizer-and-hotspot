<Window x:Class="WifiAnalyzerHotspot.SecureConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WifiAnalyzerHotspot.ViewModels"
        xmlns:controls="clr-namespace:WifiAnalyzerHotspot.Controls"
        mc:Ignorable="d"
        Title="Secure Connect — AnyConnect Wi-Fi Manager"
        Icon="pack://application:,,,/WifiAnalyzerHotspot;component/app.ico"
        Height="580" Width="380"
        MinHeight="440" MinWidth="340"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding SecureConnect.IsTopmost}"
        Background="#0C0E14"
        Foreground="#E2E8F0">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="MiniModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E2333"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2D354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A324A"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#2A324A"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Cyan Button Style -->
        <Style x:Key="MiniPrimaryBtn" TargetType="Button" BasedOn="{StaticResource MiniModernBtn}">
            <Setter Property="Background" Value="#00B0FF"/>
            <Setter Property="Foreground" Value="#0C0E14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Emerald Connect Button -->
        <Style x:Key="MiniEmeraldBtn" TargetType="Button" BasedOn="{StaticResource MiniModernBtn}">
            <Setter Property="Background" Value="#00C853"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E676"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="MiniCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#141724"/>
            <Setter Property="BorderBrush" Value="#23293D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="MiniTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#181C2B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MiniPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#181C2B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Master On/Off -->
            <RowDefinition Height="Auto"/> <!-- Active Connection Banner -->
            <RowDefinition Height="Auto"/> <!-- Password Prompt Modal (Inline) -->
            <RowDefinition Height="*"/>    <!-- Available Networks & Saved Profiles List -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: TOP HEADER & MASTER ON/OFF ==================== -->
        <Border Grid.Row="0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title & Pin Button -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6" Background="#211033" BorderBrush="#6A1B9A" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SECURE CONNECT" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="AnyConnect Wi-Fi Manager" FontSize="10" Foreground="#8F9EBC"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Pin to top toggle button -->
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleTopmostMiniWindowCommand}"
                            Style="{StaticResource MiniModernBtn}" Height="28" Padding="8,2" ToolTip="Pin window on top of other apps">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📌" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding SecureConnect.PinButtonText, FallbackValue='Pin'}"
                                       FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Master ON/OFF Switch -->
                <Border Grid.Row="1" Background="{Binding SecureConnect.MasterButtonBackground}"
                        BorderBrush="{Binding SecureConnect.MasterToggleStatusColor}"
                        BorderThickness="1.5" CornerRadius="8" Padding="10,8">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Command="{Binding ToggleSecureConnectCommand}"
                                Style="{StaticResource MiniModernBtn}" Height="30" Padding="12,2"
                                Background="#1A2234" BorderBrush="#384666">
                            <TextBlock Text="{Binding SecureConnect.MasterButtonActionText, FallbackValue='Switch'}"
                                       FontWeight="Bold" FontSize="11" Foreground="#00E5FF"/>
                        </Button>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding SecureConnect.MasterToggleStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SecureConnect.MasterToggleText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <TextBlock Text="Full power • No throttling • Fast saved connect" FontSize="10" Foreground="#8FA0C2" Margin="16,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: ACTIVE CONNECTION CARD ==================== -->
        <Border Grid.Row="1" Style="{StaticResource MiniCardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Connected Mode -->
                <DockPanel Grid.Row="0" LastChildFill="True"
                           Visibility="{Binding SecureConnect.IsConnected, Converter={StaticResource BoolVisConv}}">
                    <Button DockPanel.Dock="Right" Command="{Binding DisconnectNetworkCommand}"
                            Style="{StaticResource MiniModernBtn}" Height="28" Padding="10,2"
                            Background="#2B141B" BorderBrush="#FF1744" Foreground="#FF5252"
                            VerticalAlignment="Center" ToolTip="Disconnect from this Wi-Fi network">
                        <TextBlock Text="Disconnect" FontSize="11" FontWeight="Bold"/>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📶" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SecureConnect.ConnectedSsid}" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SecureConnect.ConnectedSignal, StringFormat='Signal: {0}%'}" FontSize="10" Foreground="#8F9EBC"/>
                            <TextBlock Text=" • " FontSize="10" Foreground="#475569"/>
                            <TextBlock Text="{Binding SecureConnect.ConnectedLinkSpeed, StringFormat='Link: {0}'}" FontSize="10" Foreground="#00E676" FontWeight="SemiBold"/>
                            <TextBlock Text=" • " FontSize="10" Foreground="#475569"/>
                            <TextBlock Text="{Binding SecureConnect.ConnectedIp}" FontSize="10" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Disconnected Mode -->
                <DockPanel Grid.Row="0" LastChildFill="True"
                           Visibility="{Binding SecureConnect.IsConnected, Converter={StaticResource BoolVisConv}, ConverterParameter=Inverse}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚪" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Not Connected" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Select network below" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Full Power Indicator -->
                <Border Grid.Row="1" Background="#0F241A" BorderBrush="#00E676" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,8,0,0"
                        Visibility="{Binding SecureConnect.IsFullPowerActive, Converter={StaticResource BoolVisConv}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="10" Margin="0,0,4,0"/>
                        <TextBlock Text="FULL POWER ACTIVE: 802.11 PSP Sleep Disabled • 100% Radio Output" FontSize="9" FontWeight="Bold" Foreground="#00E676"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== ROW 2: INLINE PASSWORD PROMPT ==================== -->
        <Border Grid.Row="2" Style="{StaticResource MiniCardBorder}" Margin="0,0,0,10" Background="#1D2133" BorderBrush="#00E5FF"
                Visibility="{Binding SecureConnect.IsPasswordPromptOpen, Converter={StaticResource BoolVisConv}}">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔒" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="CONNECT TO SECURED WI-FI" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding CancelPasswordPromptCommand}"
                            Style="{StaticResource MiniModernBtn}" Width="22" Height="22" Padding="0">
                        <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center"/>
                    </Button>
                </DockPanel>

                <TextBlock Text="{Binding SecureConnect.PasswordPromptSsid, StringFormat='Network: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>

                <PasswordBox Style="{StaticResource MiniPasswordBox}"
                             controls:PasswordBoxHelper.BoundPassword="{Binding SecureConnect.PasswordPromptInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             controls:PasswordBoxHelper.UpdateOnPasswordChanged="True" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding CancelPasswordPromptCommand}" Style="{StaticResource MiniModernBtn}" Height="30" Margin="0,0,4,0" Content="Cancel"/>
                    <Button Grid.Column="1" Command="{Binding SubmitPasswordConnectCommand}" Style="{StaticResource MiniEmeraldBtn}" Height="30" Margin="4,0,0,0" Content="Connect Now"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== ROW 3: AVAILABLE & SAVED NETWORKS ==================== -->
        <Border Grid.Row="3" Style="{StaticResource MiniCardBorder}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Refresh -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Networks -->
                </Grid.RowDefinitions>

                <!-- Search & Refresh Toolbar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Command="{Binding RefreshSecureConnectNetworksCommand}"
                            Style="{StaticResource MiniModernBtn}" Height="30" Width="32" Padding="0" Margin="6,0,0,0" ToolTip="Refresh visible Wi-Fi networks">
                        <TextBlock Text="🔄" FontSize="12" HorizontalAlignment="Center"/>
                    </Button>
                    <TextBox Style="{StaticResource MiniTextBox}" Text="{Binding SecureConnect.SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Filter networks or SSID..." Height="30"/>
                </DockPanel>

                <!-- Scrollable List of Available Networks -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SecureConnect.AvailableNetworks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161B29" BorderBrush="#232C42" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Signal Badge -->
                                            <ColumnDefinition Width="*"/>    <!-- SSID & Details -->
                                            <ColumnDefinition Width="Auto"/> <!-- Connect Button -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Signal Badge -->
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#1D2436" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SignalPercent, StringFormat='{}{0}%'}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{Binding SignalPercent, Converter={StaticResource SignalBrushConv}}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Band}" FontSize="8" Foreground="#8F9EBC" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- SSID & Security Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Ssid}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding SecurityBadge}" FontSize="9" Foreground="#8F9EBC"/>
                                                <Border Background="#1E2A38" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                        Visibility="{Binding IsSaved, Converter={StaticResource BoolVisConv}}">
                                                    <TextBlock Text="SAVED" FontSize="8" FontWeight="Bold" Foreground="#00E5FF"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action / Connect Button -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Currently Connected Badge -->
                                            <Border Background="#102C1F" BorderBrush="#00E676" BorderThickness="1" CornerRadius="5" Padding="8,4"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolVisConv}}">
                                                <TextBlock Text="✓ Connected" FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                                            </Border>

                                            <!-- Connect Button -->
                                            <Button Style="{StaticResource MiniEmeraldBtn}" Height="28" Padding="10,2"
                                                    Command="{Binding DataContext.ConnectToNetworkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolVisConv}, ConverterParameter=Inverse}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚡" FontSize="10" Margin="0,0,3,0"/>
                                                    <TextBlock Text="Connect" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ==================== ROW 4: STATUS BAR ==================== -->
        <Border Grid.Row="4" Margin="0,8,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SecureConnect.AvailableNetworks.Count, StringFormat='{}{0} visible'}"
                           FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SecureConnect.StatusMessage}" FontSize="10" Foreground="#8FA0C2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
