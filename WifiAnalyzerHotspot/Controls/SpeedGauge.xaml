<UserControl x:Class="WifiAnalyzerHotspot.Controls.SpeedGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="260">
    <Viewbox Stretch="Uniform">
        <Grid Width="260" Height="260">
            <!-- Outer Glow Circle -->
            <Ellipse Width="240" Height="240"
                     Stroke="#1E2333" StrokeThickness="14"/>

            <!-- Background Arc: -135 deg to +135 deg (270 deg total) -->
            <Path x:Name="BackgroundArc"
                  Stroke="#1F2538"
                  StrokeThickness="12"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

            <!-- Value Indicator Arc (Glowing Cyan to Purple) -->
            <Path x:Name="ValueArc"
                  StrokeThickness="12"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00E5FF" Offset="0.0"/>
                        <GradientStop Color="#7C4DFF" Offset="0.6"/>
                        <GradientStop Color="#FF4081" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>

            <!-- Center Dial Hub -->
            <Ellipse Width="170" Height="170" Fill="#131622" Stroke="#2A3045" StrokeThickness="2"/>

            <!-- Needle Line -->
            <Grid x:Name="NeedleGrid" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="NeedleTransform" Angle="-135"/>
                </Grid.RenderTransform>
                <Line X1="130" Y1="130" X2="130" Y2="25"
                      Stroke="#00E5FF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Triangle"/>
                <Ellipse Width="16" Height="16" Fill="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Center Digital Readout -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                <TextBlock x:Name="TxtSpeedValue" Text="0.0"
                           FontSize="34" FontWeight="Bold" Foreground="#FFFFFF"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="TxtUnit" Text="Mbps"
                           FontSize="14" FontWeight="SemiBold" Foreground="#00E5FF"
                           HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                <TextBlock x:Name="TxtStage" Text="READY"
                           FontSize="10" FontWeight="Bold" Foreground="#7C88A8"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
